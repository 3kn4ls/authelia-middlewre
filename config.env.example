# ============================================
# Configuración de Authelia para K3s
# ============================================
#
# INSTRUCCIONES:
# 1. Copia este archivo: cp config.env.example config.env
# 2. Edita config.env con tus valores
# 3. Ejecuta: ./scripts/install.sh
#
# ============================================

# ============================================
# CONFIGURACIÓN BÁSICA
# ============================================

# Dominio principal (OBLIGATORIO)
# Ejemplo: midominio.com
# El portal de Authelia estará en: https://auth.midominio.com
DOMAIN="TUDOMINIO.COM"

# Namespace de Kubernetes (opcional, por defecto: authelia)
NAMESPACE="authelia"

# ============================================
# USUARIOS Y ROLES
# ============================================

# Define usuarios con el formato:
# username:password:grupos:nombre_completo:email
#
# - username: Nombre de usuario para login
# - password: Password en texto plano (se hasheará automáticamente)
# - grupos: Grupos separados por comas (admins,developers,users)
# - nombre_completo: Nombre para mostrar (opcional, usa username si se omite)
# - email: Email del usuario (opcional, usa username@DOMAIN si se omite)
#
# Separa múltiples usuarios con espacios

USERS="admin:password123:admins:Administrador:admin@TUDOMINIO.COM juan:dev456:developers,testers:Juan Pérez:juan@TUDOMINIO.COM maria:view789:viewers:María García:maria@TUDOMINIO.COM"

# ============================================
# EJEMPLOS DE CONFIGURACIÓN DE USUARIOS
# ============================================

# Usuario simple (solo username y password):
# USERS="admin:miPasswordSeguro123"

# Usuario con grupos:
# USERS="admin:password123:admins,developers"

# Usuario completo:
# USERS="admin:password123:admins:Admin Principal:admin@midominio.com"

# Múltiples usuarios:
# USERS="admin:pass1:admins juan:pass2:developers maria:pass3:viewers"

# ============================================
# SECRETOS (SE GENERAN AUTOMÁTICAMENTE)
# ============================================

# Estos secretos se generarán automáticamente si no los defines
# Si quieres usar valores específicos, descoméntalos y define tus valores

# JWT_SECRET=""
# SESSION_SECRET=""
# STORAGE_ENCRYPTION_KEY=""

# Para generar secretos manualmente:
# openssl rand -hex 32

# ============================================
# CONFIGURACIÓN AVANZADA (OPCIONAL)
# ============================================

# Zona horaria
TZ="Europe/Madrid"

# Recursos del pod (opcional)
# MEMORY_REQUEST="128Mi"
# MEMORY_LIMIT="256Mi"
# CPU_REQUEST="100m"
# CPU_LIMIT="500m"

# ============================================
# NOTAS IMPORTANTES
# ============================================

# 1. Los passwords en texto plano en este archivo se hashearán con Argon2id
#    antes de guardarse en Kubernetes. El archivo config.env debe mantenerse
#    seguro y NO debe subirse a repositorios públicos.

# 2. Los secretos (JWT_SECRET, etc.) se generan automáticamente y se guardan
#    en este mismo archivo la primera vez que ejecutes install.sh

# 3. Los grupos funcionan como roles. Puedes usar cualquier nombre:
#    - admins: Administradores del sistema
#    - developers: Desarrolladores
#    - users: Usuarios normales
#    - viewers: Solo lectura
#    - support: Equipo de soporte
#    etc.

# 4. Para añadir más usuarios después de la instalación inicial:
#    - Edita este archivo añadiendo el nuevo usuario
#    - Ejecuta de nuevo: ./scripts/install.sh
#    - O edita manualmente k8s/authelia/03-secret.yaml

# 5. El dominio debe apuntar a tu IP pública y tener SSL configurado
#    (Let's Encrypt, wildcard certificate, etc.)
